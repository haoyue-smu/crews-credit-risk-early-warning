# Copy to .env and fill in. Never commit .env.

# Required
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Optional: leave these commented out to use the defaults.
# An uncommented empty OPENROUTER_MODEL_ID overrides the default with "" and breaks LLM calls.
# OPENROUTER_MODEL_ID=          # default: google/gemini-2.5-flash
# DATABASE_URL=                 # default: sqlite:///./data/crews.db

# Optional per-stage model overrides (each falls back to OPENROUTER_MODEL_ID)
# OPENROUTER_MODEL_FIS=
# OPENROUTER_MODEL_RS=
# OPENROUTER_MODEL_SIS=
# OPENROUTER_MODEL_FRD=
